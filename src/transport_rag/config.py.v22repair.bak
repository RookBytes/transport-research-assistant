from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path

from dotenv import load_dotenv

load_dotenv()


@dataclass(frozen=True)
class Settings:
    embed_model: str = os.getenv("TRA_EMBED_MODEL", "nomic-embed-text")
    ollama_url: str = os.getenv("TRA_OLLAMA_URL", "http://localhost:11434")
    ollama_model: str = os.getenv("TRA_OLLAMA_MODEL", "lfm2.5")
    top_k: int = int(os.getenv("TRA_TOP_K", "6"))
    min_score: float = float(os.getenv("TRA_MIN_SCORE", "0.20"))
    index_dir: Path = Path(os.getenv("TRA_INDEX_DIR", ".rag_index"))
    retrieval_mode: str = os.getenv("TRA_RETRIEVAL_MODE", "dense").strip().lower()
    hybrid_candidate_k: int = int(os.getenv("TRA_HYBRID_CANDIDATE_K", "15"))
    rrf_k: int = int(os.getenv("TRA_RRF_K", "60"))
    rerank_model: str = os.getenv("TRA_RERANK_MODEL", os.getenv("TRA_OLLAMA_MODEL", "lfm2.5"))
    rerank_candidate_k: int = int(os.getenv("TRA_RERANK_CANDIDATE_K", "10"))
    rerank_max_chars_per_chunk: int = int(os.getenv("TRA_RERANK_MAX_CHARS", "1400"))


settings = Settings()
